<div id="<%= dom_id site %>">
  <div>
    <strong>Name:</strong>
    <%= site.name %>
  </div>

  <div>
    <strong>Url:</strong>
    <%= site.url %>
  </div>

  <div>
    <strong>Interval seconds:</strong>
    <%= site.interval_seconds %>
  </div>

  <div>
    <strong>Enabled:</strong>
    <%= site.enabled %>
  </div>

  <div>
    <strong>Last status:</strong>
    <%= site.last_status %>
  </div>

  <div>
    <strong>Last checked at:</strong>
    <%= site.last_checked_at %>
  </div>

</div>
